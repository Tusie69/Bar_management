NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gam21_platform_dev
DB_USER=gam21
DB_PASSWORD=gam21_dev
ORGANIZATION_ID=1
VENUE_ID=1
SESSION_COOKIE_NAME=21gam_session
SESSION_TTL_HOURS=12
SESSION_CSRF_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
# Comma-separated keyId:base64 values. Generate independent 32-byte keys outside Git.
PHONE_ENCRYPTION_KEYS=
PHONE_ACTIVE_ENCRYPTION_KEY_ID=
PHONE_HMAC_KEYS=
PHONE_ACTIVE_HMAC_KEY_ID=
# No default policy: both values are required before phone reveal is enabled.
PHONE_REVEAL_RATE_LIMIT_MAX=
PHONE_REVEAL_RATE_LIMIT_WINDOW_MS=
NO_SHOW_WORKER_ENABLED=false
NO_SHOW_WORKER_INTERVAL_MS=30000
# Required only when enabled. Must reference the dedicated DISABLED user `system_no_show`
# with no membership; the API validates this invariant and otherwise fails closed.
# NO_SHOW_SYSTEM_USER_ID=
# Immutable UTC boundary; bookings created before this instant are never auto-closed.
# NO_SHOW_AUTOMATION_CUTOFF=2026-10-25T01:13:23.124Z

