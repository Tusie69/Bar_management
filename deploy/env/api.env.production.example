# Mẫu /srv/21gam/api/.env trên VPS. KHÔNG commit file .env thật.
#
# Sinh bí mật ngay trên VPS, đừng mang từ máy cá nhân lên:
#   cd /srv/21gam/api && node scripts/init-local-secrets.mjs --env-file .env
# Script tự điền SESSION_CSRF_SECRET và bộ khóa điện thoại nếu còn trống,
# và không bao giờ ghi đè giá trị đã có.
#
# Quyền file: chown gam21:gam21 .env && chmod 600 .env

NODE_ENV=production
PORT=3000

# Phải đúng origin HTTPS mà trình duyệt gõ vào, không dấu / ở cuối.
# API từ chối mọi request có Origin khác giá trị này.
WEB_ORIGIN=https://APP_DOMAIN

# Số reverse proxy đứng trước API. Nginx trên cùng máy => 1.
# Để 0 nếu API nhận request trực tiếp. Sai số này làm req.ip ghi nhầm.
TRUST_PROXY_HOPS=1

# MySQL chạy trên chính VPS, chỉ nghe loopback.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gam21_platform
DB_USER=gam21
DB_PASSWORD=

ORGANIZATION_ID=1
VENUE_ID=1

SESSION_COOKIE_NAME=21gam_session
SESSION_TTL_HOURS=12
# Tối thiểu 32 ký tự; API từ chối khởi động nếu thiếu trong production.
SESSION_CSRF_SECRET=
# Bắt buộc true trong production; API từ chối khởi động nếu false.
SESSION_COOKIE_SECURE=true
# Web và API cùng origin nên lax là đủ và an toàn hơn none.
SESSION_COOKIE_SAME_SITE=lax

# Khóa bảo vệ số điện thoại. Dạng keyId:base64-32-byte, phân cách bằng dấu phẩy.
PHONE_ENCRYPTION_KEYS=
PHONE_ACTIVE_ENCRYPTION_KEY_ID=
PHONE_HMAC_KEYS=
PHONE_ACTIVE_HMAC_KEY_ID=
# Phải cấu hình cả hai thì chức năng lộ số mới bật.
PHONE_REVEAL_RATE_LIMIT_MAX=10
PHONE_REVEAL_RATE_LIMIT_WINDOW_MS=600000

# NO_SHOW tự động vẫn tắt theo quyết định nghiệp vụ hiện tại.
NO_SHOW_POLICY_MODE=MANUAL
NO_SHOW_WORKER_ENABLED=false
NO_SHOW_WORKER_INTERVAL_MS=30000

# Tự đóng lượt khách còn mở lúc 05:00 Asia/Ho_Chi_Minh.
BUSINESS_DAY_WORKER_ENABLED=true
BUSINESS_DAY_WORKER_INTERVAL_MS=30000

# Realtime. Heartbeat phải nhỏ hơn proxy_read_timeout của nginx.
REALTIME_POLL_INTERVAL_MS=500
REALTIME_HEARTBEAT_MS=20000

# Ghép bàn chéo khu vực: tắt cho tới khi có quyết định khác.
ALLOW_CROSS_ZONE_TABLE_MERGE=false
