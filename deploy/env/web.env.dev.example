# Mẫu /srv/21gam-dev/web/.env.production cho BẢN DEV (TU-41). Vite nhúng các giá trị này vào bundle
# lúc build, nên chúng là công khai — đừng đặt bí mật ở đây.
#
# Build: cd /srv/21gam-dev/web && pnpm build
# vite.config.ts từ chối build production nếu thiếu VITE_API_MODE=http
# hoặc VITE_API_BASE_URL.

VITE_API_MODE=http

# Cùng origin với web, nên để đúng gốc tên miền. http-client tự nối /api/v1.
VITE_API_BASE_URL=https://DEV_DOMAIN

VITE_VENUE_ID=1

# Bật dải băng đỏ "MÔI TRƯỜNG DEV — DỮ LIỆU GIẢ" trên mọi cổng.
VITE_APP_ENV=dev
