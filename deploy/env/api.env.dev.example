# Mẫu /srv/21gam-dev/api/.env cho BẢN DEV (TU-41). KHÔNG commit file .env thật.
# KHÔNG chép file .env của Production sang: mọi bí mật ở đây phải sinh mới.
#
# Sinh bí mật ngay trên VPS, đừng mang từ máy cá nhân lên:
#   cd /srv/21gam-dev/api && node scripts/init-local-secrets.mjs --env-file .env
# Script tự điền SESSION_CSRF_SECRET và bộ khóa điện thoại nếu còn trống,
# và không bao giờ ghi đè giá trị đã có.
#
# Quyền file: chown gam21dev:gam21dev .env && chmod 600 .env

# Dev vẫn chạy NODE_ENV=production để giữ nguyên mọi lớp bảo vệ (secret dài,
# cookie Secure). APP_ENV mới là thứ nói "đây là bản Dev": bật dải băng phía
# API/health và mở các tính năng chỉ dành cho Dev (TU-42, TU-43).
# API từ chối khởi động nếu APP_ENV=dev mà DB_NAME không kết thúc bằng _dev.
NODE_ENV=production
APP_ENV=dev
# Production giữ cổng 3000.
PORT=3001

# Phải đúng origin HTTPS mà trình duyệt gõ vào, không dấu / ở cuối.
# API từ chối mọi request có Origin khác giá trị này.
WEB_ORIGIN=https://DEV_DOMAIN

# Số reverse proxy đứng trước API. Nginx trên cùng máy => 1.
# Để 0 nếu API nhận request trực tiếp. Sai số này làm req.ip ghi nhầm.
TRUST_PROXY_HOPS=1

# MySQL chạy trên chính VPS, chỉ nghe loopback.
DB_HOST=127.0.0.1
DB_PORT=3306
# Database và user MySQL RIÊNG. User gam21dev chỉ có quyền trên database _dev,
# nên kể cả cấu hình sai thì bản Dev cũng không chạm được vào dữ liệu quán.
DB_NAME=gam21_platform_dev
DB_USER=gam21dev
DB_PASSWORD=

ORGANIZATION_ID=1
VENUE_ID=1

# Tên cookie khác Production. Cookie vốn đã gắn riêng từng tên miền; đổi tên
# là lớp thứ hai để hai phiên không bao giờ nhầm nhau trên cùng trình duyệt.
SESSION_COOKIE_NAME=21gam_dev_session
SESSION_TTL_HOURS=12
# Tối thiểu 32 ký tự; API từ chối khởi động nếu thiếu trong production.
SESSION_CSRF_SECRET=
# Bắt buộc true trong production; API từ chối khởi động nếu false.
SESSION_COOKIE_SECURE=true
# Web và API cùng origin nên lax là đủ và an toàn hơn none.
SESSION_COOKIE_SAME_SITE=lax

# Khóa bảo vệ số điện thoại. Dạng keyId:base64-32-byte, phân cách bằng dấu phẩy.
PHONE_ENCRYPTION_KEYS=
PHONE_ACTIVE_ENCRYPTION_KEY_ID=
PHONE_HMAC_KEYS=
PHONE_ACTIVE_HMAC_KEY_ID=
# Phải cấu hình cả hai thì chức năng lộ số mới bật.
PHONE_REVEAL_RATE_LIMIT_MAX=10
PHONE_REVEAL_RATE_LIMIT_WINDOW_MS=600000

# NO_SHOW tự động vẫn tắt theo quyết định nghiệp vụ hiện tại.
NO_SHOW_POLICY_MODE=MANUAL
NO_SHOW_WORKER_ENABLED=false
NO_SHOW_WORKER_INTERVAL_MS=30000

# Tự đóng lượt khách còn mở lúc 05:00 Asia/Ho_Chi_Minh.
BUSINESS_DAY_WORKER_ENABLED=true
BUSINESS_DAY_WORKER_INTERVAL_MS=30000

# Realtime. Heartbeat phải nhỏ hơn proxy_read_timeout của nginx.
REALTIME_POLL_INTERVAL_MS=500
REALTIME_HEARTBEAT_MS=20000

# Ghép bàn chéo khu vực: tắt cho tới khi có quyết định khác.
ALLOW_CROSS_ZONE_TABLE_MERGE=false

# TU-43: mật khẩu CHUNG của các tài khoản mẫu trên Dev (superadmin_dev,
# adminedit_dev, letan_dev, phucvu_dev, bartender_dev…). Tối thiểu 12 ký tự.
# Không có giá trị mặc định và không nằm trong code (repo công khai). Đổi giá
# trị này rồi chạy lại `pnpm dev:accounts` là mọi tài khoản mẫu đổi theo.
# Đặt khác hẳn mọi mật khẩu thật của Production.
DEV_DEMO_PASSWORD=
