# Cấu hình sao lưu 21GAM (TU-31).
#
#   sudo -u gam21 cp deploy/env/backup.env.example /srv/21gam/deploy/env/backup.env
#   sudo -u gam21 chmod 600 /srv/21gam/deploy/env/backup.env
#   sudo -u gam21 nano /srv/21gam/deploy/env/backup.env
#
# File này KHÔNG chứa mật khẩu database. Mật khẩu nằm trong MySQL option file
# (~/.my.cnf, quyền 600) để không lộ ra trong `ps` hay trong journal. File này
# cũng KHÔNG chứa token rclone: token nằm trong ~/.config/rclone/rclone.conf.
#
# Không commit bản thật. .gitignore đã loại trừ deploy/env/*.env.

# Database cần sao lưu.
DB_NAME=gam21_platform

# Thư mục lưu bản local. Script tự chmod 700.
BACKUP_DIR=/srv/21gam/backups

# MySQL option file chứa [client] user/password/host. Script từ chối chạy nếu
# quyền file khác 600.
BACKUP_OPTION_FILE=/home/gam21/.my.cnf

# Đích remote dạng rclone: '<tên-remote>:<đường-dẫn>'.
# Tên remote do `rclone config` tạo ra, xem docs/deploy.md mục 7.
#
# BẮT BUỘC phải đặt. Script từ chối chạy nếu để trống, vì một bản sao lưu nằm
# cùng ổ đĩa với database không chống được hỏng ổ — mà đó lại đúng là trường
# hợp cần tới backup nhất.
#
# Đặt 'none' nếu thực sự chấp nhận chỉ lưu local (ví dụ máy dev).
BACKUP_REMOTE=gdrive-21gam:21GAM/backups

# Lệnh được gọi kèm một dòng mô tả khi backup thất bại. Để trống thì chỉ dựa
# vào exit code và OnFailure=21gam-backup-failed.service.
# Ví dụ: BACKUP_ALERT_COMMAND=/srv/21gam/deploy/scripts/notify-zalo.sh
BACKUP_ALERT_COMMAND=

# Ngưỡng tối thiểu của bản dump sau khi nén. Dump rỗng vẫn là gzip hợp lệ, nên
# kích thước là chốt duy nhất bắt được "mysqldump chạy xong nhưng không ra dữ
# liệu". Nâng dần theo kích thước thật của database.
BACKUP_MIN_BYTES=20480

# Database dùng cho diễn tập phục hồi (restore-verify.sh).
# Bắt buộc có hậu tố _test; script từ chối mọi tên khác.
RESTORE_TEST_DB=gam21_restore_test
