MYSQL_ROOT_PASSWORD=gam21_root_dev
MYSQL_DATABASE=gam21_platform_dev
MYSQL_USER=gam21
MYSQL_PASSWORD=gam21_dev
MYSQL_PORT=3306

# Automatic NO_SHOW is fail-closed until a dedicated DISABLED `system_no_show`
# user with no membership is provisioned and its id is configured here.
NO_SHOW_WORKER_ENABLED=false
NO_SHOW_WORKER_INTERVAL_MS=30000
# NO_SHOW_SYSTEM_USER_ID=
# NO_SHOW_AUTOMATION_CUTOFF=2026-10-25T01:13:23.124Z

# Automatically close open visits and release their tables at 05:00 Asia/Ho_Chi_Minh.
BUSINESS_DAY_WORKER_ENABLED=true
BUSINESS_DAY_WORKER_INTERVAL_MS=30000

