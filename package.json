{
  "name": "bar-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["web", "api"],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web && npm run lint --workspace api",
    "test": "npm run test --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api"
  },
  "engines": { "node": ">=22" }
}
